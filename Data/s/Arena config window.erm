****************************************************************************************************
* Persistent Runtime configuration
****************************************************************************************************
!?FU(Arena_LoadOptionsFromIni);
!!VR(filePath:z):S^Runtime/arena config.ini^;
!!FU(ReadIniInts):P(filePath)/^Arena^/
  ^Arena_Normal_Difficulty^/?i^Arena_Normal_Difficulty^/i^Arena_Normal_Difficulty^/
  ^Arena_Boss_Difficulty^/?i^Arena_Boss_Difficulty^/i^Arena_Boss_Difficulty^;

!!SN:W^Arena_Normal_Difficulty^/?y1;
!!SN&y1<1:W^Arena_Normal_Difficulty^/2;
!!SN&y1>4:W^Arena_Normal_Difficulty^/2;
!!SN:W^Arena_Boss_Difficulty^/?y1;
!!SN&y1<1:W^Arena_Boss_Difficulty^/2;
!!SN&y1>4:W^Arena_Boss_Difficulty^/2;


!?FU(Arena_SaveOptionsToIni);
!!VR(filePath:z):S^Runtime/arena config.ini^;
!!FU(WriteIniInts):P(filePath)/^Arena^/
  ^Arena_Normal_Difficulty^/i^Arena_Normal_Difficulty^/
  ^Arena_Boss_Difficulty^/i^Arena_Boss_Difficulty^/;
!!FU(SaveIni):P(filePath);


* Load the global setting when ERA initializes the scripts
!?PI;
!!FU(Arena_LoadOptionsFromIni):P;
