* Public defaults: Lang/configuration.json may override these values.
* Saved values from Runtime/arena config.ini take final precedence.
!#VRi^Arena_Normal_Difficulty^:S2;
!#VRi^Arena_Boss_Difficulty^:S2;
!#VRi^Arena_Config_Loaded^:S(FALSE);

!?FU(Arena_LoadJsonDefaults);
!!FU(LoadIntGlobalsFromJson):P^arena_mod.settings.^/^Arena_^/^Config_Loaded^;
!!FU(LoadIntGlobalsFromJson)&i^Arena_Config_Loaded^:P^arena_mod.settings.^/^Arena_^/
  ^Normal_Difficulty^/^Boss_Difficulty^;

!#FU(Arena_LoadJsonDefaults):P;


!?FU(Configure_Arena_mod);              [Open the Arena configuration]

!!DL171:N^Arena_Set.txt^;               [Parse dialogue]
!!FU(Arena_LoadOptionsFromIni):P;       [Load the persistent Runtime setting]

* Alternate between the light MM7 style and the current dark style whenever the window opens
!!SN:W^Arena_Config_Next_Light_Style^/?y2;
!!VRy2&y2<>1:S0;
!!VRy3:S0;
!!if&y2=0;
  !!VRy3:S1;
  !!SN:W^Arena_Config_Next_Light_Style^/1;
!!el;
  !!SN:W^Arena_Config_Next_Light_Style^/0;
!!en;
!!SN:W^Arena_Config_Active_Light_Style^/y3;

